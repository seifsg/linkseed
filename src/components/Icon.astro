---
/** Inline SVG icons (decorative, hidden from screen readers). */
interface Props { name: 'sprout' | 'leaf' | 'clock' }
const { name } = Astro.props;
---
{name === 'sprout' && (
  <svg viewBox="0 0 32 32" aria-hidden="true" fill="none">
    <rect width="32" height="32" rx="9" fill="var(--chip)" />
    <path d="M16 26V15" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" />
    <path d="M16 16c0-5 3.5-8 9-8 0 5.5-3.5 8.5-9 8Z" fill="var(--accent)" />
    <path d="M16 19c0-4-2.8-6.5-7.5-6.5 0 4.4 2.8 6.9 7.5 6.5Z" fill="var(--accent)" opacity=".7" />
  </svg>
)}
{name === 'leaf' && (
  <svg viewBox="0 0 20 20" aria-hidden="true" fill="currentColor">
    <path d="M17 3c-7.5 0-12 3.6-12 9.3 0 1.4.4 2.6 1 3.6L4 18l1.2 1 2-2.1c1 .6 2.2.9 3.5.9C16.3 17.8 17 9.8 17 3Zm-6.6 7.3c-1.6 1.1-2.9 2.5-3.9 4.2l-.9-.6c1.1-1.8 2.5-3.3 4.2-4.5l.6.9Z" />
  </svg>
)}
{name === 'clock' && (
  <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <circle cx="10" cy="10" r="7.2" /><path d="M10 6v4.3l2.8 1.7" />
  </svg>
)}
