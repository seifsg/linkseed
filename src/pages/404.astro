---
/** Not-found page. */
import Base from '../layouts/Base.astro';
import { SITE_NAME, SUBMIT_URL } from '../config.ts';
---
<Base title={`Page not found · ${SITE_NAME}`} description="This page does not exist on Linkseed." path="/404/" noindex>
  <section class="page">
    <h1>Nothing has sprouted here</h1>
    <p class="lede">The page you asked for does not exist, or the listing was removed.</p>
    <p>
      <a class="btn btn-primary" href="/">Browse apps</a>
      <a class="btn btn-ghost" href={SUBMIT_URL}>Submit your app</a>
    </p>
  </section>
</Base>
